{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/lead-follow-up-problem.html",
      "destination": "/lead-follow-up-problem",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/portfolio/projects/:slug",
      "destination": "/portfolio-project"
    }
  ]
}
